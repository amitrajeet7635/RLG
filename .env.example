# Database (SQLite by default, zero setup required)
DATABASE_URL="file:./dev.db"

# (Optional) Google Gemini API Key for smart opportunity analysis & custom outreach pitch generation
# Leave blank to use ultra-fast built-in Rule-Based / Heuristic Engine
GEMINI_API_KEY=

# (Optional) Telegram Instant Alert Credentials
# Create a bot via @BotFather and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Optional) Discord Webhook URL for backup notifications
DISCORD_WEBHOOK_URL=

# (Optional) Reddit Official API Credentials (Optional - poller uses public feeds by default)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="webdev-freelance-bot:v1.0.0 (by /u/reddituser)"

# Bot Operation Settings
POLL_INTERVAL_SECONDS=20
POSTS_PER_SUBREDDIT=5
MIN_OPPORTUNITY_SCORE=70
MIN_NOTIFICATION_SCORE=75
PORT=3000
NODE_ENV=development
